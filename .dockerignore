# Build artifacts (rebuilt inside the image; the cargo target dir and the
# vendored CoolProp clone live in BuildKit cache mounts instead).
/target
vendor/

# Local tooling / editor state
.claude/
.idea/
.git/

# Published API spec (regenerated by `task openapi`, not needed to build)
openapi.json
openapi.yaml

# Docker/compose files themselves are irrelevant to the build context
Dockerfile
docker-compose.yml
.dockerignore

# Docs
README.md
